{
  "name": "python-language-levels",
  "displayName": "Python Language Levels",
  "description": "Beginner-friendly Python in the editor: an integrated REPL with inline images, tables and animations, language levels, and friendly errors. Powered by Pyodide. Works in desktop VS Code and vscode.dev.",
  "version": "0.1.2",
  "publisher": "pll",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dbp/pll.git"
  },
  "bugs": {
    "url": "https://github.com/dbp/pll/issues"
  },
  "homepage": "https://github.com/dbp/pll",
  "keywords": [
    "python",
    "education",
    "beginner",
    "repl",
    "pyodide",
    "learning",
    "animation",
    "htdp",
    "images"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "PLL runs Python inside Pyodide. It does not execute workspace files on the host."
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "packageManager": "pnpm@10.33.2",
  "categories": [
    "Programming Languages",
    "Education",
    "Other"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onView:pllInteractionsView"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pll.showInteractions",
        "title": "PLL: Show Interactions"
      },
      {
        "command": "pll.startRepl",
        "title": "PLL: Start REPL"
      },
      {
        "command": "pll.runActiveFile",
        "title": "PLL: Run Python File"
      },
      {
        "command": "pll.clearInteractions",
        "title": "PLL: Clear Interactions"
      },
      {
        "command": "pll.stopProgram",
        "title": "PLL: Stop Program"
      },
      {
        "command": "pll.editor.copy",
        "title": "PLL: Editor Copy"
      },
      {
        "command": "pll.editor.cut",
        "title": "PLL: Editor Cut"
      },
      {
        "command": "pll.editor.paste",
        "title": "PLL: Editor Paste"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "pll.runActiveFile",
          "when": "editorLangId == python",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "pllPanel",
          "title": "PLL",
          "icon": "media/pll-icon.svg"
        }
      ]
    },
    "views": {
      "pllPanel": [
        {
          "id": "pllInteractionsView",
          "name": "Interactions",
          "type": "webview",
          "contextualTitle": "PLL"
        }
      ]
    },
    "configuration": {
      "title": "Python Language Levels",
      "properties": {
        "pll.pyodideIndexUrl": {
          "type": "string",
          "default": "https://cdn.jsdelivr.net/pyodide/v0.29.3/full/",
          "description": "Base URL used to load Pyodide assets. Must end with a trailing slash."
        },
        "pll.newFileLevel": {
          "type": "string",
          "enum": [
            "none",
            "raw",
            "beginner",
            "intermediate",
            "advanced"
          ],
          "enumDescriptions": [
            "Do not add a level line.",
            "Add `#level raw` - plain Python, nothing checked.",
            "Add `#level beginner` - all checks.",
            "Add `#level intermediate` - all checks, but rebinding inside a function is allowed.",
            "Add `#level advanced` - no checks before the run; annotations still checked."
          ],
          "default": "none",
          "markdownDescription": "Level line to put at the top of a newly created `.py` file, for example `#level beginner`. Only applies to files created empty; PLL never edits a file that already has content. This is a template for new files and does **not** change what an existing file without a level line does - that is always `raw`."
        }
      }
    },
    "configurationDefaults": {
      "[python]": {
        "editor.quickSuggestions": {
          "other": "off",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": false,
        "editor.acceptSuggestionOnEnter": "off",
        "editor.tabCompletion": "off",
        "editor.wordBasedSuggestions": "off",
        "editor.parameterHints.enabled": false,
        "editor.snippetSuggestions": "none",
        "editor.suggest.showWords": false,
        "editor.suggest.showSnippets": false,
        "editor.inlineSuggest.enabled": false,
        "editor.codeLens": false,
        "editor.lightbulb.enabled": "off",
        "editor.minimap.enabled": false,
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false,
        "editor.stickyScroll.enabled": false,
        "editor.linkedEditing": false,
        "editor.editContext": false,
        "editor.experimentalEditContextEnabled": false
      },
      "editor.editContext": false,
      "editor.experimentalEditContextEnabled": false,
      "workbench.startupEditor": "none",
      "github.copilot.enable": {
        "python": false
      },
      "github.copilot.editor.enableAutoCompletions": false,
      "cursor.cpp.disabledLanguages": [
        "python"
      ],
      "python.languageServer": "None",
      "python.linting.enabled": false,
      "python.linting.pylintEnabled": false,
      "python.linting.flake8Enabled": false,
      "python.linting.mypyEnabled": false,
      "python.linting.banditEnabled": false,
      "python.linting.pycodestyleEnabled": false,
      "python.linting.pydocstyleEnabled": false,
      "python.analysis.diagnosticMode": "openFilesOnly",
      "python.analysis.diagnosticSeverityOverrides": {},
      "python.analysis.autoImportCompletions": false,
      "python.analysis.typeCheckingMode": "off",
      "python.analysis.completeFunctionParens": false,
      "python.analysis.indexing": false,
      "python.analysis.useLibraryCodeForTypes": false,
      "python.formatting.provider": "none",
      "python.terminal.activateEnvironment": false,
      "python.experiments.enabled": false,
      "python.showStartPage": false,
      "pylint.enabled": false,
      "pylint.ignorePatterns": [
        "**"
      ],
      "flake8.enabled": false,
      "flake8.ignorePatterns": [
        "**"
      ],
      "bandit.enabled": false,
      "bandit.ignorePatterns": [
        "**"
      ],
      "mypy-type-checker.enabled": false,
      "mypy-type-checker.ignorePatterns": [
        "**"
      ],
      "mypy-type-checker.reportingScope": "file",
      "mypy.runUsingActiveInterpreter": false,
      "mypy.checkNotebookFiles": false,
      "mypy.checkAllOpenFolders": false,
      "mypy.targets": [],
      "pyright.disableLanguageServices": true,
      "pyright.disableOrganizeImports": true,
      "basedpyright.disableLanguageServices": true,
      "basedpyright.disableOrganizeImports": true,
      "ruff.enable": false,
      "ruff.lint.enable": false,
      "ruff.ignorePatterns": [
        "**"
      ],
      "black-formatter.formatOnSave": false,
      "isort.formatOnSave": false,
      "breadcrumbs.enabled": false
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "compile": "tsc -p ./ --noEmit",
    "package": "node esbuild.config.mjs --production",
    "vscode:prepublish": "pnpm run package",
    "vsce:package": "vsce package --no-dependencies",
    "vsce:publish": "vsce publish --no-dependencies",
    "setup:browser": "playwright install chromium",
    "test-web": "pnpm run setup:browser && pnpm run build && vscode-test-web --browser=chromium --coi --permission=clipboard-read --permission=clipboard-write --extensionDevelopmentPath=. samples",
    "test-web:clipboard": "pnpm run build && node scripts/smoke-editor-clipboard.mjs",
    "test-web:stop": "pnpm run build && node scripts/smoke-web-stop.mjs",
    "test-web:server": "pnpm run build && vscode-test-web --browser=none --coi --permission=clipboard-read --permission=clipboard-write --extensionDevelopmentPath=. samples",
    "smoke": "pnpm run build && node scripts/smoke-repl-session.mjs && node scripts/smoke-new-file-level.mjs && node scripts/smoke-worker-protocol.mjs && node scripts/smoke-static-analyze.mjs && node scripts/smoke-explainers.mjs && node scripts/smoke-images.mjs && node scripts/smoke-tables.mjs && node scripts/smoke-tests.mjs && node scripts/smoke-typecheck.mjs && node scripts/smoke-pandas.mjs && node scripts/smoke-input.mjs && node scripts/smoke-workspace-files.mjs && node scripts/smoke-universe.mjs && node scripts/smoke-examplar.mjs && node scripts/smoke-examplar-build.mjs && node scripts/smoke-cli.mjs && node scripts/smoke-interrupt.mjs && node scripts/smoke-desktop-parity.mjs",
    "test-web:reactor": "pnpm run build && node scripts/smoke-web-reactor.mjs",
    "test-web:universe": "pnpm run build && node scripts/smoke-web-universe.mjs",
    "test-web:examplar": "pnpm run build && node scripts/smoke-web-examplar.mjs",
    "cli:pack": "pnpm run build && cd dist-cli && npm pack",
    "cli:publish": "pnpm run build && cd dist-cli && npm publish --access public"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-web": "^0.0.80",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "playwright": "^1.59.1",
    "pyodide": "^0.29.3",
    "typescript": "^6.0.3"
  },
  "vsce": {
    "dependencies": false
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@playwright/browser-chromium",
      "esbuild"
    ]
  }
}
